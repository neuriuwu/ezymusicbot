+def _fetch_booru_sync(tag: str, nsfw: bool, danbooru_user: str, danbooru_key: str):
+    """Synchronous version of booru fetch for executor use."""
+    if nsfw:
+        url = "https://danbooru.donmai.us/posts.json"
+        base_params = {'limit': 50}
+        if danbooru_user and danbooru_key:
+            base_params['login'] = danbooru_user
+            base_params['api_key'] = danbooru_key
+
+        # Fetch explicit + questionable separately and combine
+        combined = []
+        for rating in ('e', 'q'):
+            params = {**base_params, 'tags': f'{tag} rating:{rating}'}
+            try:
+                r = requests.get(url, params=params, timeout=10)
+                r.raise_for_status()
+                combined.extend(r.json())
+            except Exception:
+                pass
+
+        # If neither search returned anything, fall back to unfiltered
+        if not combined:
+            params = {**base_params, 'tags': tag, 'limit': 100}
+            try:
+                r = requests.get(url, params=params, timeout=10)
+                r.raise_for_status()
+                combined = r.json()
+            except Exception:
+                pass
+
+        if not combined:
+            return None, None, "Danbooru"
+        post = random.choice(combined)
+        img = post.get('file_url', '')
+        if not img.startswith('http'):
+            img = f"https://danbooru.donmai.us{img}"
+        return img, f"https://danbooru.donmai.us/posts/{post.get('id')}", "Danbooru"
+    else:
+        url = "https://safebooru.org/index.php?page=dapi&s=post&q=index&json=1"
+        params = {'tags': tag, 'limit': 100}
+        response = requests.get(url, params=params, timeout=10)
+        response.raise_for_status()
+        data = response.json()
+        if not data:
+            return None, None, "Safebooru"
+        post = random.choice(data)
+        img = post.get('file_url') or f"https://safebooru.org/images/{post.get('directory')}/{post.get('image')}"
+        if not img.startswith('http'):
+            img = f"https:{img}" if img.startswith('//') else f"https://safebooru.org/{img.lstrip('/')}"
+        return img, f"https://safebooru.org/index.php?page=post&s=view&id={post.get('id')}", "Safebooru"
+
