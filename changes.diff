+async def fetch_booru_image(tag: str, nsfw: bool, danbooru_user: str, danbooru_key: str):
+    """Shared fetch logic for Danbooru (nsfw) or Safebooru (sfw).
+    Returns (image_url, post_url, source_name) or raises on error."""
+    if nsfw:
+        url = "https://danbooru.donmai.us/posts.json"
+        params = {'tags': tag, 'limit': 100, 'login': danbooru_user, 'api_key': danbooru_key}
+        response = requests.get(url, params=params, timeout=10)
+        response.raise_for_status()
+        data = response.json()
+        if not data:
+            return None, None, "Danbooru"
+        post = random.choice(data)
+        img = post.get('file_url', '')
+        if not img.startswith('http'):
+            img = f"https://danbooru.donmai.us{img}"
+        return img, f"https://danbooru.donmai.us/posts/{post.get('id')}", "Danbooru"
+    else:
+        url = "https://safebooru.org/index.php?page=dapi&s=post&q=index&json=1"
+        params = {'tags': tag, 'limit': 100}
+        response = requests.get(url, params=params, timeout=10)
+        response.raise_for_status()
+        data = response.json()
+        if not data:
+            return None, None, "Safebooru"
+        post = random.choice(data)
+        img = post.get('file_url') or f"https://safebooru.org/images/{post.get('directory')}/{post.get('image')}"
+        if not img.startswith('http'):
+            img = f"https:{img}" if img.startswith('//') else f"https://safebooru.org/{img.lstrip('/')}"
+        return img, f"https://safebooru.org/index.php?page=post&s=view&id={post.get('id')}", "Safebooru"
+
