# Discord Bot Token
# Get your token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=BOT_TOKEN_HERE

# Danbooru API Configuration (optional - for image commands)
# Get your API key from: https://danbooru.donmai.us/profile
# Example: https://danbooru.donmai.us/profile.json?api_key=KEYHERE&login=LOGINHERE
DANBOORU_USERNAME=LOGINHERE
DANBOORU_API_KEY=KEYHERE
